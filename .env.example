# ฐานข้อมูล MongoDB - ใส่ connection string จาก MongoDB Atlas หรือ MongoDB local ของคุณ
DATABASE_URI=mongodb+srv://<username>:<password>@<cluster-host>/enhouse?retryWrites=true&w=majority

# ตั้งเป็นข้อความลับอะไรก็ได้ (ใช้เข้ารหัส session)
PAYLOAD_SECRET=change-me-to-a-random-string

# URL ของเว็บไซต์ (ใช้สร้างลิงก์ Live Preview) — ตอน dev ใช้ localhost ได้เลย
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ตั้งเป็นข้อความลับอีกชุด (คนละค่ากับ PAYLOAD_SECRET) ใช้ป้องกันลิงก์ Preview
PREVIEW_SECRET=change-me-to-another-random-string

# (ไม่บังคับ) เชื่อม Resend เพื่อส่ง Email แจ้งเตือนเมื่อมี Lead ใหม่
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=noreply@enhouse.digital
# NOTIFY_TO_EMAIL=marketing@enhouse.digital
